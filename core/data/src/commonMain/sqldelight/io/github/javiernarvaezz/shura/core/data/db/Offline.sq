-- Songs kept to listen without a connection (Phase 3, E6): what to show without a network, and the file's format
-- (itag) and size. The files are in the app's private, encrypted offline cache, keyed "<video_id>:<itag>".
CREATE TABLE offline_song (
    video_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artist_names TEXT NOT NULL,
    artist_ids TEXT NOT NULL,
    album_title TEXT,
    album_id TEXT,
    duration_ms INTEGER,
    thumbnail_url TEXT,
    explicit INTEGER NOT NULL,
    itag INTEGER NOT NULL,
    bytes INTEGER NOT NULL,
    saved_at INTEGER NOT NULL,
    -- 0 while the download is under way (it survives the process), 1 once the whole file is kept.
    complete INTEGER NOT NULL
);

offlineSongs:
SELECT * FROM offline_song ORDER BY saved_at DESC, rowid DESC;

putOfflineSong:
INSERT OR REPLACE INTO offline_song VALUES ?;

completeOfflineSong:
UPDATE offline_song SET complete = 1, bytes = :bytes WHERE video_id = :videoId;

removeOfflineSong:
DELETE FROM offline_song WHERE video_id = ?;

clearOfflineSongs:
DELETE FROM offline_song;
