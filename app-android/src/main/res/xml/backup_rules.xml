<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower: only the app database, and only to an end-to-end encrypted backup (Android 9+; the flag is
  ignored on 8.x). Everything else (WebView data, files, shared preferences, session store) stays on the device.
-->
<full-backup-content>
    <include domain="database" path="shura.db" requireFlags="clientSideEncryption" />
</full-backup-content>
