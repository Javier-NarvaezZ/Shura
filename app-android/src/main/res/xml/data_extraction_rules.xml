<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: only the app database (queue, history, settings, lyrics cache, library) is backed up and moved to a
  new device. Listing what is included excludes everything else: the WebView's data, files, shared preferences and
  any session store (which must never leave the device). Cloud backup only with end-to-end encryption.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="shura.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="shura.db" />
    </device-transfer>
</data-extraction-rules>
